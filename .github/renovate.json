{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>iwamot/renovate-config#v0.23.0"
  ],
  "packageRules": [
    {
      "description": "Keep local and container Python on 3.14 until fastuuid supports Python 3.15",
      "matchManagers": ["mise", "dockerfile"],
      "matchPackageNames": ["python/cpython", "dhi.io/python"],
      "allowedVersions": "/^3\\.14\\./"
    }
  ]
}
