{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>iwamot/renovate-config#v0.23.0"
  ],
  "packageRules": [
    {
      "description": "Keep Docker on Python 3.14 until fastuuid supports Python 3.15",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["dhi.io/python"],
      "allowedVersions": "/^3\\.14\\./"
    }
  ]
}
